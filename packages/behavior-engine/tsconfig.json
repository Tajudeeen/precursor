{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "lib": ["ES2022"],
    "strict": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "declaration": true,
    "outDir": "dist",
    "types": ["node"],
    "paths": {
      "@precursor/shared": ["../shared/dist/index.js"]
    }
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}
